--cpu Cortex-M3
"breath_change\startup_stm32f103xb.o"
"breath_change\main.o"
"breath_change\gpio.o"
"breath_change\tim.o"
"breath_change\stm32f1xx_it.o"
"breath_change\stm32f1xx_hal_msp.o"
"breath_change\stm32f1xx_hal_gpio_ex.o"
"breath_change\stm32f1xx_hal_tim.o"
"breath_change\stm32f1xx_hal_tim_ex.o"
"breath_change\stm32f1xx_hal.o"
"breath_change\stm32f1xx_hal_rcc.o"
"breath_change\stm32f1xx_hal_rcc_ex.o"
"breath_change\stm32f1xx_hal_gpio.o"
"breath_change\stm32f1xx_hal_dma.o"
"breath_change\stm32f1xx_hal_cortex.o"
"breath_change\stm32f1xx_hal_pwr.o"
"breath_change\stm32f1xx_hal_flash.o"
